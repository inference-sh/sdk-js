{
  "$comment": "Generated by `make proxy-endpoints` from the route table (internal/api/proxy_endpoints_test.go). Do not edit.",
  "preset": "run-only",
  "endpoints": [
    {
      "method": "POST",
      "path": "/apps/run",
      "purpose": "run an app",
      "scopes": [
        "apps:execute",
        "apps:read",
        "conversations:read"
      ]
    },
    {
      "method": "POST",
      "path": "/files",
      "purpose": "upload a file input of a run or message",
      "scopes": [
        "files:write"
      ]
    },
    {
      "method": "GET",
      "path": "/tasks/{id}",
      "purpose": "read a task",
      "scopes": [
        "apps:read"
      ]
    },
    {
      "method": "GET",
      "path": "/tasks/{id}/status",
      "purpose": "poll a task",
      "scopes": [
        "apps:read"
      ]
    },
    {
      "method": "GET",
      "path": "/tasks/{id}/stream",
      "purpose": "stream a task",
      "scopes": [
        "apps:read",
        "conversations:read",
        "flows:read"
      ]
    },
    {
      "method": "POST",
      "path": "/tasks/{id}/cancel",
      "purpose": "cancel a task",
      "scopes": [
        "apps:execute"
      ]
    },
    {
      "method": "POST",
      "path": "/agents/run",
      "purpose": "send a message to an agent",
      "scopes": [
        "agents:execute",
        "conversations:read"
      ]
    },
    {
      "method": "POST",
      "path": "/chats",
      "purpose": "start a chat with an agent",
      "scopes": [
        "conversations:write"
      ]
    },
    {
      "method": "POST",
      "path": "/chats/{id}/messages",
      "purpose": "send a message in a chat",
      "scopes": [
        "agents:execute"
      ]
    },
    {
      "method": "POST",
      "path": "/chats/{id}/agent",
      "purpose": "hand a chat to another agent",
      "scopes": [
        "conversations:write"
      ]
    },
    {
      "method": "GET",
      "path": "/agents/{namespace}/{name}",
      "purpose": "read an agent's info",
      "scopes": [
        "agents:read"
      ]
    },
    {
      "method": "GET",
      "path": "/chats/{id}",
      "purpose": "read a chat",
      "scopes": [
        "conversations:read"
      ]
    },
    {
      "method": "GET",
      "path": "/chats/{id}/status",
      "purpose": "poll a chat",
      "scopes": [
        "conversations:read"
      ]
    },
    {
      "method": "GET",
      "path": "/chats/{id}/messages",
      "purpose": "read a chat's messages",
      "scopes": [
        "conversations:read"
      ]
    },
    {
      "method": "GET",
      "path": "/chats/{id}/stream",
      "purpose": "stream a chat",
      "scopes": [
        "conversations:read"
      ]
    },
    {
      "method": "POST",
      "path": "/chats/{id}/stop",
      "purpose": "stop a chat",
      "scopes": [
        "conversations:write"
      ]
    },
    {
      "method": "POST",
      "path": "/chats/messages/{messageId}/cancel",
      "purpose": "cancel a message",
      "scopes": [
        "conversations:read",
        "conversations:write"
      ]
    },
    {
      "method": "POST",
      "path": "/tools/{toolId}",
      "purpose": "answer a client tool call",
      "scopes": [
        "conversations:write"
      ]
    }
  ]
}
