{
  "compilerOptions": {
    "target": "es2020",
    "module": "NodeNext",
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    // NodeNext, not bundler: dist/ is loaded by plain Node ESM, which does not
    // add extensions or resolve directory imports. tsc now rejects a relative
    // import without its .js extension.
    "moduleResolution": "NodeNext",
    // src/version.ts imports package.json so the version has one source.
    "resolveJsonModule": true,
    // Required: consumers (js/app dev server) transpile this package's source
    // per-file, so type-only re-exports must be marked `export type`.
    "isolatedModules": true,
    "types": ["node", "jest"],
    "jsx": "react-jsx"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
} 